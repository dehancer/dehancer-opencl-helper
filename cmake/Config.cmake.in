@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(NOT TARGET OpenCL::OpenCL)
    find_dependency(OpenCL 1.2)
endif()
if(WIN32 AND NOT TARGET dlfcn-win32::dl)
    find_dependency(dlfcn-win32 CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/dehancer_opencl_helperTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/clHelper.cmake")
check_required_components(dehancer_opencl_helper)
